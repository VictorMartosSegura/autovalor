# Copy this file as .env and fill the real values locally.
# Never commit .env with real credentials.

# Database
DB_URL=jdbc:postgresql://HOST:PORT/defaultdb?sslmode=require
DB_USERNAME=YOUR_DB_USER
DB_PASSWORD=YOUR_DB_SECRET

# JWT
JWT_SECRET=YOUR_LONG_RANDOM_JWT_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRATION_MINUTES=1440

# Admin bootstrap
ADMIN_NAME=AutoValor Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=YOUR_ADMIN_SECRET

# Uploads
UPLOAD_DIR=uploads
MAX_IMAGES_PER_LISTING=6
MAX_FILE_SIZE=5MB
MAX_REQUEST_SIZE=20MB

# AI vehicle suggestions
AI_ENABLED=false
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-4o-mini

# Frontend URLs allowed by CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional deployment config
JPA_DDL_AUTO=update
PORT=8080
SPRING_PROFILES_ACTIVE=prod
